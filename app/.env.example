# Waitlist form submissions via Formspree (https://formspree.io)
# 1. Create a free account at formspree.io
# 2. Create a new form and copy the form ID (e.g. "xpwzqnpl")
# 3. Set this variable in Vercel's environment settings
# If not set, form will simulate success without sending data (demo mode)
VITE_FORMSPREE_ID=your_form_id_here

# Campus Map cloud sync (Supabase)
# The app ships with the CollegeAdvisor project's PUBLIC keys baked in, so sync
# works out of the box. Override these only if you point the app at a different
# Supabase project. The anon/publishable key is safe to expose in the browser —
# all access is protected by row-level security.
# Find these in your Supabase dashboard under Settings > API.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
